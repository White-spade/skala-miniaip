# LangSmith tracing (optional)
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ai-minip
LANGSMITH_API_KEY=YOUR_LANGSMITH_API_KEY

# FastAPI OAuth2/JWT (required for step23_auth_api.py)
# Generate a random value: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIOPS_JWT_SECRET=YOUR_JWT_SECRET_32_CHARACTERS_OR_MORE

# STEP 24: run optional LLM semantic validation after Grounding
ENABLE_SEMANTIC_VALIDATION=true
